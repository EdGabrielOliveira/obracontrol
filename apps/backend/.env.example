# ==============================================================================
# ObraControl Backend — Arquivo de Exemplo de Variáveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env. Os valores abaixo são os de produção no cPanel.
# Para desenvolvimento local, substitua as URLs, NODE_ENV e caminhos marcados
# nos comentários por valores localhost/locais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Principais da Aplicação
# ------------------------------------------------------------------------------
# Ambiente de execução: development | production | test
NODE_ENV=production

# Porta TCP em que o servidor Bun/Elysia irá escutar
PORT=7001

# Interface de rede. No Docker, use 0.0.0.0 para aceitar conexões publicadas.
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Banco de Dados SQLite & Armazenamento de Arquivos
# ------------------------------------------------------------------------------
# URL do banco de dados SQLite principal
# Produção (Docker com volume em /data): file:/data/obracontrol.db
# Local sem Docker: file:./prisma/dev.db
DATABASE_URL=file:/data/obracontrol.db

# Diretório para armazenamento local de uploads, planilhas e anexos
# Produção (Docker com volume em /data): /data/objects
# Local sem Docker: .local-objects
OBJECT_STORAGE_DIR=/data/objects

# Banco SQLite descartável usado exclusivamente pelos testes automatizados (test:e2e-db)
TEST_DATABASE_URL=file:./prisma/test.db

# ------------------------------------------------------------------------------
# 3. Autenticação e Segurança (Better-Auth)
# ------------------------------------------------------------------------------
# Segredo aleatório para assinatura de tokens de sessão (mínimo de 32 caracteres).
# Dica para gerar no terminal: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string-with-at-least-32-chars

# Chave mestra usada na tela de primeiro acesso para criar o primeiro usuário ADMIN.
# Mínimo de 16 caracteres. Guarde em local seguro.
ADMIN_REGISTRATION_KEY=change-me-to-a-random-authorization-key-16-chars

# URL pública pela qual o navegador acessa os endpoints de autenticação (/api/auth)
# Produção: https://api.obracontrol.engpac.com.br
# Desenvolvimento local: http://localhost:7001
BETTER_AUTH_URL=http://localhost:7001

# Origem do Frontend permitida pelo CORS
# Produção: https://obracontrol.engpac.com.br
# Desenvolvimento local: http://localhost:7000
FRONTEND_ORIGIN=http://localhost:7000

# Origens adicionais confiáveis para autenticação/CORS (opcional, separadas por vírgula)
AUTH_TRUSTED_ORIGINS=https://obracontrol.engpac.com.br

# ------------------------------------------------------------------------------
# 4. Proxy Reverso & Rede (Opcional)
# ------------------------------------------------------------------------------
# IPs ou sub-redes dos proxies reversos confiáveis (ex: 127.0.0.1, 10.0.0.0/8).
# Quando preenchido, habilita a leitura segura dos headers X-Forwarded-For.
TRUSTED_PROXY=127.0.0.1,::1

# Porta publicada localmente pelo Docker; o Apache/cPanel faz proxy para ela.
API_PORT=7001

# ------------------------------------------------------------------------------
# 5. Monitoramento e Logs (Opcional)
# ------------------------------------------------------------------------------
# DSN do Sentry para rastreamento de erros em produção
SENTRY_DSN=

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# Dias de retenção dos logs de auditoria antes do expurgo automático (padrão: 180 dias)
AUDIT_LOG_RETENTION_DAYS=180

# ------------------------------------------------------------------------------
# 6. Seed Inicial e Flags Operacionais
# ------------------------------------------------------------------------------
# Credenciais para seed automático do admin (usado em scripts de seed)
SEED_ADMIN_EMAIL=admin@obracontrol.local
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=change-me-strong-password

# Proteção contra reset acidental: bun run db:reset só executa com RESET_CONFIRM=yes
RESET_CONFIRM=no

# Flag de auditoria para bloqueio de contratos legados após migração estrutural
AUDIT_RELEASE_B=false
