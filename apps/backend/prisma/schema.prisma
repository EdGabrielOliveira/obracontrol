generator client {
	provider  = "prisma-client-js"
	engineType = "library"
	previewFeatures = ["prismaSchemaFolder"]
}

// Generated client Node.js usado pelo adaptador PostgreSQL e pela API.
generator prismaClient {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "nodejs"
  output     = "../generated/prisma"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}
