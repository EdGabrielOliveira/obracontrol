{
	"name": "obracontrol-backend",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "bun run db:setup:local && bun --watch src/index.ts",
		"start": "bun run db:setup:local && bun src/index.ts",
		"start:container": "bun src/index.ts",
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"ci:verify": "bun prisma validate && bun run db:generate && bun run typecheck && bun run check && bun run test:unity && bun run test:e2e-db",
		"test:unit": "bun test --isolate tests/unit",
		"test:integration": "bun test --isolate tests/integration",
		"test:unity": "bun run test:unit && bun run test:integration",
		"test:coverage": "bun test --isolate tests/unit tests/integration --coverage --coverage-reporter=text",
		"spellcheck": "cspell --no-progress",
		"db:test:setup": "bun tests/scripts/database/create-test-db.ts && bun tests/scripts/database/migrate-test-db.ts",
		"test:e2e-db": "bun run db:test:setup && bun tests/scripts/database/run-e2e-db-tests.ts",
		"db:generate": "bun prisma generate",
		"db:setup:local": "bun prisma db push --skip-generate && bun prisma/scripts/normalize-imported-measurement-statuses.ts",
		"db:migrate:dev": "bun prisma db push --skip-generate",
		"db:push": "bun prisma db push --skip-generate",
		"db:studio": "bunx prisma studio",
		"db:seed": "bun prisma/seed.ts",
		"verify:prisma": "tsx scripts/verify-prisma.ts",
		"db:seed:smoke": "bun tests/scripts/seed-smoke.ts",
		"db:bootstrap:contracts": "bun prisma/scripts/bootstrap-contract-companies.ts",
		"db:workspaces:dry-run": "bun prisma/scripts/migrate-workspaces.ts --dry-run",
		"db:workspaces:apply": "bun prisma/scripts/migrate-workspaces.ts --apply",
		"budget:identity:backfill": "bun prisma/scripts/backfill-budget-item-identities.ts",
		"budget:reconcile": "bun prisma/scripts/reconcile-budget-versions.ts",
		"budget:repair-baselines": "bun prisma/scripts/repair-missing-budget-baselines.ts",
		"execution-facts:audit": "bun prisma/scripts/audit-execution-facts.ts",
		"db:reset": "bun scripts/reset-db.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/swagger": "^1.3.1",
		"@libsql/client": "^0.17.4",
		"@prisma/adapter-libsql": "6.18.0",
		"@prisma/client": "6.18.0",
		"@sentry/node": "^10.69.0",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.3.32",
		"decimal.js": "^10.6.0",
		"dotenv": "^17.4.2",
		"elysia": "^1.4.13",
		"fflate": "^0.8.2",
		"pdf-lib": "^1.17.1",
		"xlsx": "^0.18.5",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.0",
		"@types/bun": "^1.3.1",
		"@types/node": "^26.2.0",
		"cspell": "^10.0.1",
		"cspell-dict-pt-br": "^1.1.1",
		"prisma": "6.18.0",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3"
	}
}
