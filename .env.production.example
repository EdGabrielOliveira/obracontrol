# Copie para .env na VPS antes de executar o Compose de produção.
NODE_ENV=production
WEB_PORT=7000

# PostgreSQL interno do Compose. Use uma senha sem caracteres reservados na URL
# ou aplique URL encoding na DATABASE_URL.
POSTGRES_DB=obracontrol
POSTGRES_USER=obracontrol
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql://obracontrol:replace-with-a-strong-postgres-password@postgres:5432/obracontrol?schema=public

# Gere valores únicos e fortes; nunca reutilize os valores deste exemplo.
# Exemplo: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_REGISTRATION_KEY=replace-with-a-random-admin-registration-key

# As três URLs devem refletir o domínio público servido pelo proxy reverso.
BETTER_AUTH_URL=https://obracontrol.example.com
FRONTEND_ORIGIN=https://obracontrol.example.com
AUTH_TRUSTED_ORIGINS=https://obracontrol.example.com
TRUSTED_PROXY=127.0.0.1,::1

# Deixe vazio para o frontend usar o proxy same-origin do Nginx.
VITE_SERVER_URL=
VITE_SENTRY_DSN=
SENTRY_DSN=
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=180
PDF_CONVERSION_TIMEOUT_SECONDS=45
PDF_CONVERSION_QUEUE_LIMIT=2
WORKSPACE_BACKFILL_ON_BOOT=true
