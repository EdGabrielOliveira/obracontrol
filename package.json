{
	"name": "obracontrol-monorepo",
	"private": true,
	"workspaces": ["apps/backend", "apps/frontend"],
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev:backend": "bun run --cwd apps/backend dev",
		"dev:frontend": "bun run --cwd apps/frontend dev",
		"dev:docker": "docker compose -f docker-compose.development.yml up --build",
		"dev:docker:down": "docker compose -f docker-compose.development.yml down",
		"prod:config": "docker compose config --quiet",
		"prod:up": "docker compose up -d --build --remove-orphans",
		"prod:down": "docker compose down",
		"prod:logs": "docker compose logs -f --tail=200",
		"prod:update": "bash ops/update-vps.sh",
		"build:frontend": "bun run --cwd apps/frontend build",
		"check:backend": "bun run --cwd apps/backend check",
		"check:frontend": "bun run --cwd apps/frontend check",
		"check": "bun run check:backend && bun run check:frontend",
		"typecheck:backend": "bun run --cwd apps/backend typecheck",
		"typecheck:frontend": "bun run --cwd apps/frontend typecheck",
		"typecheck": "bun run typecheck:backend && bun run typecheck:frontend",
		"test:backend": "bun run --cwd apps/backend test:unity",
		"test:frontend": "bun run --cwd apps/frontend test",
		"test": "bun run test:backend && bun run test:frontend",
		"ci:verify": "bun run check && bun run typecheck && bun run test && bun run build:frontend"
	}
}
